{
    "$schema": "https://lnav.org/schemas/config-v1.schema.json",
    "log": {
        "stack-frames": {
            "no-line": {
                "pattern": "^\\s+at (?<file>\\S+\\.foo)"
            },
            "bad-regex": {
                "pattern": "^(?<file>"
            },
            "no-regex": {
                "languages": ["java"]
            },
            "bad-languages": {
                "pattern": "^\\s+at (?<file>\\S+\\.foo):(?<line>\\d+)",
                "languages": ["foolang"]
            }
        }
    }
}
