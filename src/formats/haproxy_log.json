{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "haproxy_log": {
        "title": "HAProxy HTTP Log Format",
        "description": "The HAProxy log format",
        "url": "http://www.haproxy.org/download/1.4/doc/configuration.txt",
        "regex": {
            "event_started": {
                "pattern": "^(?<timestamp>\\w{3} \\d{2} \\d{2}:\\d{2}:\\d{2}) (?<logging_host>[^ ]+) (?<process_name>\\w+)\\[(?<pid>\\d+)\\]: Proxy (?<frontend_name>[^ ]+) started."
            },
            "event_stopping": {
                "pattern": "^(?<timestamp>\\w{3} \\d{2} \\d{2}:\\d{2}:\\d{2}) (?<logging_host>[^ ]+) (?<process_name>\\w+)\\[(?<pid>\\d+)\\]: Stopping frontend (?<frontend_name>[^ ]+) in (?<stopping_timeout>\\d+) ms."
            },
            "event_stopped": {
                "pattern": "^(?<timestamp>\\w{3} \\d{2} \\d{2}:\\d{2}:\\d{2}) (?<logging_host>[^ ]+) (?<process_name>\\w+)\\[(?<pid>\\d+)\\]: Proxy (?<frontend_name>[^ ]+) stopped \\(FE: (?<frontend_connections>\\d+) conns, BE: (?<backend_connections>\\d+) conns\\)."
            },
            "tcp": {
                "pattern": "^(?<timestamp>\\w{3} \\d{2} \\d{2}:\\d{2}:\\d{2}) (?<logging_host>[^ ]+) (?<process_name>\\w+)\\[(?<pid>\\d+)\\]: (?<client_ip>[^:]+):(?<client_port>\\d+) \\[(?<accept_date>\\d{2}\\/\\w{3}\\/\\d{4}:\\d{2}:\\d{2}:\\d{2}.\\d{3})\\] (?<frontend_name>[^ ]+) (?<backend_name>[^ ]+)\\/(?<server_name>[^ ]+) (?<tw>\\d+)\\/(?<tc>\\d+)\\/(?<tt>\\d+) (?<bytes_read>\\d+) (?<termination_state>..) (?<actconn>\\d+)\\/(?<feconn>\\d+)\\/(?<beconn>\\d+)\\/(?<srv_conn>\\d+)\\/(?<retries>\\d+) (?<srv_queue>\\d+)\\/(?<backend_queue>\\d+)"
            },
            "http": {
                "pattern": "^(?<timestamp>\\w{3} \\d{2} \\d{2}:\\d{2}:\\d{2}) (?<logging_host>[^ ]+) (?<process_name>\\w+)\\[(?<pid>\\d+)\\]: (?<client_ip>[^:]+):(?<client_port>\\d+) \\[(?<accept_date>\\d{2}\\/\\w{3}\\/\\d{4}:\\d{2}:\\d{2}:\\d{2}.\\d{3})\\] (?<frontend_name>[^ ]+)(?<ssl>~)? (?<backend_name>[^ ]+)\\/(?<server_name>[^ ]+) (?<tq>-?\\d+)\\/(?<tw>-?\\d+)\\/(?<tc>-?\\d+)\\/(?<tr>-?\\d+)\\/(?<tt>\\d+) (?<status_code>\\d{3}|-1) (?<bytes_read>\\d+) (?<captured_request_cookie>.*) (?<captured_response_cookie>.*) (?<termination_state>....) (?<actconn>\\d+)\\/(?<feconn>\\d+)\\/(?<beconn>\\d+)\\/(?<srv_conn>\\d+)\\/(?<retries>\\d+) (?<srv_queue>\\d+)\\/(?<backend_queue>\\d+) (?:\\{(?<captured_request_headers>.*)\\} \\{(?<captured_response_headers>.*)\\} )?\"(?<http_method>[A-Z<>]+)(?: (?<http_url>.*?))?(?: (?<http_version>HTTP\\/\\d+.\\d+))?\"?$"
            },
            "ssl": {
                "pattern": "^(?<timestamp>\\w{3} \\d{2} \\d{2}:\\d{2}:\\d{2}) (?<logging_host>[^ ]+) (?<process_name>\\w+)\\[(?<pid>\\d+)\\]: (?<client_ip>[^:]+):(?<client_port>\\d+) \\[(?<accept_date>\\d{2}\\/\\w{3}\\/\\d{4}:\\d{2}:\\d{2}:\\d{2}.\\d{3})\\] (?<backend_name>[^ ]+)\\/(?<server_name>[^ ]+): (?<ssl_error>.+)$"
            }
        },
        "value": {
            "stopping_timeout": {
                "description": "The milliseconds the frontend waits for its connections before stopping",
                "kind": "integer"
            },
            "frontend_connections": {
                "description": "The number of connections the frontend had",
                "kind": "integer"
            },
            "backend_connections": {
                "description": "The number of connections the backend had",
                "kind": "integer"
            },
            "logging_host": {
                "description": "The host that sent the message to syslog",
                "kind": "string"
            },
            "process_name": {
                "description": "The name of the HAProxy process",
                "kind": "string"
            },
            "pid": {
                "description": "The ID of the HAProxy process",
                "kind": "integer",
                "foreign-key": true
            },
            "client_ip": {
                "description": "The IP address of the client",
                "kind": "string",
                "collate": "ipaddress"
            },
            "client_port": {
                "description": "The port of the client",
                "kind": "integer",
                "foreign-key": true
            },
            "accept_date": {
                "description": "The time the connection was accepted",
                "kind": "string"
            },
            "frontend_name": {
                "description": "The name of the frontend (listener) that received the connection",
                "kind": "string",
                "identifier": true
            },
            "ssl": {
                "description": "Whether the connection used SSL",
                "kind": "string"
            },
            "ssl_error": {
                "description": "The SSL error that ended the connection",
                "kind": "string"
            },
            "backend_name": {
                "description": "The name of the backend chosen for the request",
                "kind": "string",
                "identifier": true
            },
            "server_name": {
                "description": "The name of the server the request was sent to",
                "kind": "string",
                "identifier": true
            },
            "tq": {
                "description": "The milliseconds spent waiting for the client to send the whole request",
                "kind": "integer",
                "unit": {
                    "suffix": "s",
                    "divisor": 1000
                }
            },
            "tw": {
                "description": "The milliseconds spent waiting in queues for a connection slot",
                "kind": "integer",
                "unit": {
                    "suffix": "s",
                    "divisor": 1000
                }
            },
            "tc": {
                "description": "The milliseconds spent establishing the connection to the server",
                "kind": "integer",
                "unit": {
                    "suffix": "s",
                    "divisor": 1000
                }
            },
            "tr": {
                "description": "The milliseconds spent waiting for the server to send the response headers",
                "kind": "integer",
                "unit": {
                    "suffix": "s",
                    "divisor": 1000
                }
            },
            "tt": {
                "description": "The milliseconds from accepting the connection to closing it",
                "kind": "integer",
                "unit": {
                    "suffix": "s",
                    "divisor": 1000
                }
            },
            "status_code": {
                "description": "The HTTP status code returned to the client",
                "kind": "integer",
                "identifier": true
            },
            "bytes_read": {
                "description": "The bytes sent to the client",
                "kind": "integer",
                "unit": {
                    "suffix": "B"
                }
            },
            "captured_request_cookie": {
                "description": "The request cookie captured by the configuration",
                "kind": "string"
            },
            "captured_response_cookie": {
                "description": "The response cookie captured by the configuration",
                "kind": "string"
            },
            "termination_state": {
                "description": "How the session ended, as HAProxy's four-letter state code",
                "kind": "string"
            },
            "actconn": {
                "description": "The number of connections the process had when this one was logged",
                "kind": "integer",
                "foreign-key": true
            },
            "feconn": {
                "description": "The number of connections the frontend had when this one was logged",
                "kind": "integer",
                "foreign-key": true
            },
            "beconn": {
                "description": "The number of connections the backend had when this one was logged",
                "kind": "integer",
                "foreign-key": true
            },
            "srv_conn": {
                "description": "The number of connections the server had when this one was logged",
                "kind": "integer",
                "foreign-key": true
            },
            "retries": {
                "description": "The number of times the connection to a server was retried",
                "kind": "integer"
            },
            "srv_queue": {
                "description": "The number of requests ahead of this one in the server's queue",
                "kind": "integer",
                "foreign-key": true
            },
            "backend_queue": {
                "description": "The number of requests ahead of this one in the backend's queue",
                "kind": "integer",
                "foreign-key": true
            },
            "captured_request_headers": {
                "description": "The request headers captured by the configuration",
                "kind": "string"
            },
            "captured_response_headers": {
                "description": "The response headers captured by the configuration",
                "kind": "string"
            },
            "http_method": {
                "description": "The request method",
                "kind": "string",
                "identifier": true
            },
            "http_url": {
                "description": "The request URL",
                "kind": "string"
            },
            "http_version": {
                "description": "The request's HTTP version",
                "kind": "string"
            }
        },
        "sample": [
            {
                "line": "Feb 26 10:07:24 192.168.8.2 haproxy[1]: Proxy prod_http_in started."
            },
            {
                "line": "Feb 26 10:00:47 192.168.8.2 haproxy[7]: Stopping frontend prod_http_in in 0 ms."
            },
            {
                "line": "Feb 26 10:00:47 192.168.8.2 haproxy[7]: Proxy prod_http_in stopped (FE: 847876 conns, BE: 0 conns)."
            },
            {
                "line": "Feb 26 23:08:47 192.168.8.2 haproxy[7]: 178.203.144.192:50210 [26/Feb/2019:23:08:47.266] prod_http_in/slsp: Connection closed during SSL handshake"
            },
            {
                "line": "Feb 26 23:16:16 192.168.8.2 haproxy[7]: 178.203.144.192:50210 [26/Feb/2019:23:16:15.321] prod_ssh_in prod_ssh_out/ssh1 1/1/861 1485 -- 2/1/0/0/0 0/0"
            },
            {
                "line": "Feb 26 00:29:44 192.168.8.2 haproxy[7]: 178.203.144.192:50210 [26/Feb/2019:00:29:44.326] prod_http_in~ prod_http_out/nginx1 0/0/1/48/49 200 3313 - - ---- 3/2/0/0/0 0/0 {Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:65.0) Gecko/20100101 Firefox/65.0} {} \"POST /schulportal/?Script=934&lehrer=126537&anm=3235&onlinetest=admin HTTP/1.1\""
            }
        ]
    }
}