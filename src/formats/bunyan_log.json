{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "bunyan_log": {
        "title": "Bunyan log",
        "url": "https://github.com/trentm/node-bunyan",
        "description": "Bunyan JSON logging library for node.js",
        "file-type": "json",
        "line-format": [
            {
                "field": "__timestamp__"
            },
            " ",
            {
                "field": "name"
            },
            "[",
            {
                "field": "pid"
            },
            "] ",
            {
                "field": "__level__",
                "text-transform": "uppercase",
                "auto-width": true
            },
            {
                "field": "src/file",
                "default-value": "",
                "prefix": "["
            },
            {
                "field": "src/line",
                "default-value": "",
                "prefix": ":"
            },
            {
                "field": "src/func",
                "default-value": "",
                "prefix": ":",
                "suffix": "]"
            },
            " ",
            {
                "field": "msg"
            }
        ],
        "level-field": "level",
        "src-file-field": "src/file",
        "src-line-field": "src/line",
        "thread-id-field": "pid",
        "level": {
            "fatal": 60,
            "error": 50,
            "warning": 40,
            "info": 30,
            "debug": 20,
            "trace": 10
        },
        "value": {
            "pid": {
                "description": "The ID of the process that logged the message",
                "kind": "integer",
                "identifier": true
            },
            "name": {
                "description": "The name of the logger, usually the application's",
                "kind": "string",
                "identifier": true
            },
            "hostname": {
                "description": "The host the process ran on",
                "kind": "string",
                "identifier": true,
                "hidden": true
            },
            "time": {
                "description": "The time the message was logged",
                "kind": "string",
                "identifier": false
            },
            "level": {
                "description": "The message's level as a number: 10 trace, 20 debug, 30 info, 40 warn, 50 error, 60 fatal",
                "kind": "integer",
                "identifier": true,
                "foreign-key": true
            },
            "v": {
                "description": "The Bunyan log format version",
                "kind": "integer",
                "hidden": true
            },
            "msg": {
                "description": "The message",
                "kind": "string"
            },
            "src": {
                "description": "Where in the source the message was logged, when the logger records it",
                "kind": "json",
                "hidden": true
            },
            "src/file": {
                "description": "The source file that logged the message",
                "kind": "string",
                "identifier": true
            },
            "src/line": {
                "description": "The line in the source file that logged the message",
                "kind": "integer"
            },
            "src/func": {
                "description": "The function that logged the message",
                "kind": "string",
                "identifier": true
            }
        },
        "timestamp-field": "time",
        "body-field": "msg"
    }
}
