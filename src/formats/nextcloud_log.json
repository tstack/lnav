{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "nextcloud": {
        "title": "Nextcloud server logs",
        "description": "Nextcloud JSON server logs audit.log, flow.log, and nextcloud.log",
        "url": "https://docs.nextcloud.com/server/stable/admin_manual/configuration_server/logging_configuration.html?highlight=logging#log-field-breakdown",
        "file-type": "json",
        "opid-field": "reqId",
        "level-field": "level",
        "body-field": "message",
        "hide-extra": true,
        "level": {
            "debug": 0,
            "info": 1,
            "warning": 2,
            "error": 3,
            "fatal": 4
        },
        "timestamp-field": "time",
        "convert-to-local-time": true,
        "multiline": false,
        "value": {
            "exception": {
                "description": "The exception logged with the message",
                "kind": "json",
                "hidden": true
            },
            "exception/Exception": {
                "description": "The exception's class",
                "kind": "string",
                "identifier": true
            },
            "exception/Message": {
                "description": "The exception's message",
                "kind": "string"
            },
            "app": {
                "description": "The Nextcloud app that logged the message",
                "kind": "string",
                "identifier": true
            },
            "reqId": {
                "description": "The ID of the request the message is about",
                "kind": "string",
                "identifier": true
            },
            "remoteAddr": {
                "description": "The IP address of the client",
                "kind": "string",
                "identifier": true
            },
            "url": {
                "description": "The request URL",
                "kind": "string",
                "hidden": true
            },
            "method": {
                "description": "The request method",
                "kind": "string",
                "hidden": true
            },
            "user": {
                "description": "The user who made the request",
                "kind": "string",
                "identifier": true,
                "hidden": true
            },
            "userAgent": {
                "description": "The request's User-Agent header",
                "kind": "string",
                "hidden": true
            },
            "version": {
                "description": "The Nextcloud version",
                "kind": "string",
                "hidden": true
            },
            "data": {
                "description": "Extra data logged with the message",
                "kind": "json",
                "hidden": true
            }
        },
        "line-format": [
            "[",
            {
                "field": "__level__",
                "text-transform": "uppercase"
            },
            "] ",
            {
                "field": "__timestamp__"
            },
            " ",
            {
                "field": "reqId",
                "max-width": 3,
                "overflow": "truncate"
            },
            " ",
            {
                "field": "remoteAddr",
                "min-width": 9,
                "max-width": 9,
                "overflow": "dot-dot"
            },
            " ",
            {
                "field": "app",
                "min-width": 12,
                "max-width": 12,
                "overflow": "truncate"
            },
            " ",
            {
                "field": "message"
            },
            {
                "field": "exception/Exception",
                "prefix": "\t\t",
                "suffix": "",
                "default-value": ""
            },
            {
                "field": "exception/Message",
                "prefix": ": \u201c",
                "suffix": "\u201d",
                "default-value": ""
            },
            {
                "field": "data",
                "default-value": ""
            }
        ]
    }
}
