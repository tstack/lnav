{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "journald_json_log": {
        "title": "journalctl JSON log format",
        "description": "Logger format as created by systemd journalctl -o json",
        "url": "https://www.freedesktop.org/wiki/Software/systemd/json/",
        "file-type": "json",
        "hide-extra": true,
        "convert-to-local-time": true,
        "line-format": [
            {
                "field": "__REALTIME_TIMESTAMP"
            },
            " ",
            {
                "field": "__MONOTONIC_TIMESTAMP"
            },
            " ",
            {
                "field": "_SYSTEMD_UNIT"
            },
            " ",
            {
                "field": "SYSLOG_IDENTIFIER"
            },
            "[",
            {
                "field": "_PID"
            },
            "] ",
            {
                "field": "__level__",
                "text-transform": "uppercase"
            },
            " ",
            {
                "field": "MESSAGE"
            }
        ],
        "timestamp-field": "__REALTIME_TIMESTAMP",
        "timestamp-format": [
            "%6"
        ],
        "level-field": "PRIORITY",
        "level": {
            "fatal": "0|1",
            "critical": "2",
            "error": "3",
            "warning": "4",
            "stats": "5",
            "info": "6",
            "debug": "7"
        },
        "body-field": "MESSAGE",
        "value": {
            "__REALTIME_TIMESTAMP": {
                "description": "The time the journal received the message, in microseconds since the epoch",
                "kind": "integer"
            },
            "__MONOTONIC_TIMESTAMP": {
                "description": "The microseconds since the system booted when the journal received the message",
                "kind": "integer"
            },
            "_SYSTEMD_UNIT": {
                "description": "The systemd unit the process belongs to",
                "kind": "string",
                "identifier": true
            },
            "SYSLOG_IDENTIFIER": {
                "description": "The name the program logged under",
                "kind": "string",
                "identifier": true
            },
            "_PID": {
                "description": "The ID of the process that logged the message",
                "kind": "integer",
                "identifier": true
            },
            "PRIORITY": {
                "description": "The message's syslog priority: 0 emerg to 7 debug",
                "kind": "string",
                "identifier": true,
                "foreign-key": true
            },
            "MESSAGE": {
                "description": "The message",
                "kind": "string"
            }
        }
    }
}