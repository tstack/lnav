{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "dmesg_log": {
        "title": "Linux dmesg log format",
        "description": "Log format for the Linux kernel's dmesg command",
        "regex": {
            "decoded": {
                "pattern": "^(?<facility>[a-z0-9]+)\\s*:(?<level>[a-z]+)\\s*: \\[(?<timestamp>\\s*\\d+\\.\\d+)\\] (?<body>.*)"
            },
            "elapsed": {
                "pattern": "^\\[(?<timestamp>\\s*\\d+\\.\\d+)\\] (?<body>.*)"
            }
        },
        "level": {
            "fatal": "^(?:emerg|alert)$",
            "critical": "^crit$",
            "error": "^err$",
            "warning": "^warn$",
            "notice": "^notice$",
            "info": "^info$",
            "debug": "^debug$"
        },
        "value": {
            "facility": {
                "kind": "string",
                "identifier": true,
                "description": "The syslog facility of the message, from 'dmesg --decode'"
            }
        },
        "timestamp-format": [
            "%E.%f"
        ],
        "timestamp-anchor": {
            "pattern": "setting system clock to .* \\((\\d+)\\)$",
            "format": "%s"
        },
        "sample": [
            {
                "line": "[    0.000000] Initializing cgroup subsys cpuset"
            },
            {
                "line": "kern  :info  : [    0.000000] Linux version 6.1.0-13-amd64",
                "level": "info"
            },
            {
                "line": "kern  :warn  : [    0.123456] ACPI: _OSC evaluation for CPUs failed, trying _PDC",
                "level": "warning"
            },
            {
                "line": "kern  :err   : [    1.100000] usb 1-1: device descriptor read/64, error -71",
                "level": "error"
            },
            {
                "line": "daemon:notice: [    5.678901] systemd[1]: Started Journal Service.",
                "level": "notice"
            }
        ]
    }
}
