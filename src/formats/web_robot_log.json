{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "web_robot_log": {
        "title": "web robot log",
        "description": "",
        "url": "https://github.com/pamburus/hl/issues/132",
        "file-type": "json",
        "line-format": [
            {
                "field": "ip"
            },
            " ",
            {
                "prefix": "[",
                "field": "__timestamp__",
                "suffix": "]"
            },
            " \"",
            {
                "field": "method"
            },
            " ",
            {
                "field": "resource"
            },
            "\" ",
            {
                "field": "response"
            },
            " ",
            {
                "field": "bytes"
            },
            " ",
            {
                "field": "referrer",
                "default-value": "-"
            },
            " ",
            {
                "field": "useragent",
                "default-value": "-"
            }
        ],
        "value": {
            "ip": {
                "description": "The IP address of the client",
                "kind": "string",
                "collate": "ipaddress",
                "identifier": true
            },
            "level": {
                "description": "The message's level",
                "kind": "string",
                "hidden": true
            },
            "method": {
                "description": "The request method",
                "kind": "string",
                "identifier": true
            },
            "resource": {
                "description": "The requested resource",
                "kind": "string",
                "identifier": true
            },
            "response": {
                "description": "The response's HTTP status code",
                "kind": "integer",
                "foreign-key": true
            },
            "bytes": {
                "description": "The size of the response, in bytes",
                "kind": "integer"
            },
            "referrer": {
                "description": "The request's Referer header",
                "kind": "string",
                "identifier": true
            },
            "request": {
                "description": "The request line",
                "kind": "string",
                "hidden": true
            },
            "request-id": {
                "description": "The ID of the request",
                "kind": "string",
                "hidden": true,
                "identifier": true
            },
            "useragent": {
                "description": "The request's User-Agent header",
                "kind": "string"
            }
        }
    }
}