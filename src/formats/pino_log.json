{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "pino_log": {
        "title": "Pino log",
        "url": "https://github.com/pinojs/pino",
        "description": "Pino JSON logging library for node.js",
        "file-type": "json",
        "line-format": [
            {
                "field": "__timestamp__"
            },
            " ",
            {
                "field": "hostname"
            },
            "[",
            {
                "field": "pid"
            },
            "] ",
            {
                "field": "__level__",
                "text-transform": "uppercase",
                "auto-width": true
            },
            " ",
            {
                "field": "msg"
            }
        ],
        "level-field": "level",
        "level": {
            "fatal": 60,
            "error": 50,
            "warning": 40,
            "info": 30,
            "debug": 20,
            "trace": 10
        },
        "value": {
            "pid": {
                "description": "The ID of the process that logged the message",
                "kind": "integer",
                "identifier": true
            },
            "hostname": {
                "description": "The host the process ran on",
                "kind": "string",
                "identifier": true
            },
            "level": {
                "description": "The message's level as a number: 10 trace, 20 debug, 30 info, 40 warn, 50 error, 60 fatal",
                "kind": "integer",
                "identifier": true,
                "foreign-key": true
            },
            "msg": {
                "description": "The message",
                "kind": "string"
            }
        },
        "timestamp-field": "time",
        "timestamp-divisor": 1000,
        "body-field": "msg",
        "thread-id-field": "pid"
    }
}
