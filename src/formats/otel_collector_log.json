{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "otel_collector_log": {
        "title": "OpenTelemetry Collector File Exporter",
        "description": "Format for OpenTelemetry Collector file exporter JSON logs",
        "url": "https://opentelemetry.io/docs/specs/otel/protocol/file-exporter/",
        "file-type": "json",
        "convert-to-local-time": true,
        "converter": {
            "header": {
                "expr": {
                    "otel_collector": ":header REGEXP '.*227265736f757263654c6f677322.*'"
                },
                "size": 100
            },
            "command": "otel_collector_log-converter.sh"
        },
        "line-format": [
            {
                "field": "__timestamp__"
            },
            " ",
            {
                "field": "__level__",
                "text-transform": "uppercase",
                "min-width": 5
            },
            " ",
            {
                "field": "service.name",
                "default-value": "-",
                "auto-width": true
            },
            " ",
            {
                "field": "body"
            },
            {
                "field": "trace_id",
                "prefix": " [trace:",
                "suffix": "]",
                "default-value": ""
            }
        ],
        "level-field": "severity",
        "level": {
            "fatal": "FATAL",
            "error": "ERROR",
            "warning": "WARN",
            "info": "INFO",
            "debug": "DEBUG",
            "trace": "TRACE"
        },
        "timestamp-field": "timestamp_ns",
        "timestamp-format": [
            "%9"
        ],
        "body-field": "body",
        "opid-field": "trace_id",
        "hide-extra": true,
        "value": {
            "observed_ns": {
                "description": "The time the collector observed the message, in nanoseconds since the epoch",
                "kind": "string",
                "hidden": true
            },
            "severity_number": {
                "description": "The message's severity as an OpenTelemetry number, from 1 (trace) to 24 (fatal)",
                "kind": "integer",
                "identifier": true
            },
            "severity": {
                "description": "The message's severity",
                "kind": "string",
                "identifier": true
            },
            "body": {
                "description": "The message",
                "kind": "string"
            },
            "trace_id": {
                "description": "The ID of the trace the message is part of",
                "kind": "string",
                "identifier": true
            },
            "span_id": {
                "description": "The ID of the span the message is part of",
                "kind": "string",
                "identifier": true
            },
            "flags": {
                "description": "The trace flags",
                "kind": "integer",
                "hidden": true
            },
            "scope_name": {
                "description": "The name of the instrumentation scope, usually the logger's",
                "kind": "string",
                "identifier": true
            },
            "service.name": {
                "description": "The name of the service that logged the message",
                "kind": "string",
                "identifier": true
            },
            "host.name": {
                "description": "The host the service ran on",
                "kind": "string",
                "identifier": true,
                "hidden": true
            },
            "deployment.environment": {
                "description": "The environment the service was deployed to",
                "kind": "string",
                "identifier": true,
                "hidden": true
            }
        },
        "sample": [
            {
                "line": "{\"timestamp_ns\":\"1700000000000000000\",\"severity\":\"INFO\",\"severity_number\":9,\"body\":\"Application started successfully\",\"trace_id\":\"abc123\",\"span_id\":\"def456\",\"scope_name\":\"app.main\",\"service.name\":\"my-service\"}"
            }
        ]
    }
}
